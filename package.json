{
  "name": "sloke",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted download orchestration: a task bus + adapters that route BT to qBittorrent, RSS/direct to built-in downloads, and drop everything into your media directories.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --cwd packages/server run dev",
    "build": "bun run build --workspaces",
    "test": "bun test",
    "typecheck": "bun tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
